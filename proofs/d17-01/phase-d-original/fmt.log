    643  |+    function _payoutBoth(uint256 id, uint256 earned, uint256 refund) private {
    644  |+        VM.prank(GYM);
    645  |+        require(vault.claimEarned(id) == earned, "direct gym payout");
    646  |+        VM.prank(BUYER);
    647  |+        require(vault.claimRefund(id) == refund, "direct buyer refund");
    648  |+    }
    649  |+
    650  |+    function _reject(address caller, bytes4 selector) private {
    651  |+        VM.expectRevert(selector);
    652  |+        VM.prank(caller);
    653  |+    }
    654  |+
    655  |+    function _ledger(uint256 id, uint256 locked, uint256 earned, uint256 refund, uint256 disputed, uint256 unallocated)
    656  |+        private
    657  |+        view
    658  |+    {
    659  |+        (uint256 l, uint256 e, uint256 r, uint256 d, uint256 u) = vault.getBalances(id);
    660  |+        require(l == locked && e == earned && r == refund && d == disputed && u == unallocated, "ledger");
    661  |+        V.Agreement memory a = vault.getAgreement(id);
    662  |+        require(a.deposited == a.gymWithdrawn + a.buyerRefunded + l, "deposit conservation");
    663  |+        require(a.earnedFinalized + a.refundAuthorized + u == a.deposited, "allocation conservation");
    664  |+        require(d <= u && token.balanceOf(address(vault)) >= l, "escrow backing");
    665  |+    }
    666  |+}
