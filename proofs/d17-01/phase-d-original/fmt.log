    601  |+    function _session(uint256 id, uint256 sessionId) private returns (uint256) {
    602  |+        VM.prank(GYM);
    603  |+        return vault.proposeSession(id, bytes32(sessionId), EVIDENCE);
    604  |+    }
    605  |+
    606  |+    function _challengeSession(uint256 id, uint256 sessionId) private returns (uint256 claim) {
    607  |+        claim = _session(id, sessionId);
    608  |+        VM.prank(BUYER);
    609  |+        vault.challengeClaim(id, claim, EVIDENCE);
    610  |+    }
