{
  "name": "openreserve",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "services/catalog-evidence",
    "services/chain-indexer",
    "services/economics",
    "packages/api-contracts",
    "packages/contracts-sdk"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "prebuild": "npm run build --workspace @openreserve/api-contracts --workspace @openreserve/contracts-sdk",
    "pretypecheck": "npm run prebuild",
    "test": "npm run test --workspaces --if-present",
    "test:isolation": "node scripts/service-isolation.mjs",
    "sdk:generate": "node scripts/generate-sdk.mjs",
    "sdk:check": "node scripts/generate-sdk.mjs --check"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "typescript": "5.9.3"
  }
}
