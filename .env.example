# Local-only example credentials: replace in untracked .env; use URL-safe passwords.
WEB_PORT=4173
CATALOG_PORT=3001
CHAIN_PORT=3002
ECONOMICS_PORT=3003
POSTGRES_PASSWORD=local_example_admin_replace
CATALOG_DB_PASSWORD=local_example_catalog_replace
CHAIN_DB_PASSWORD=local_example_chain_replace
# D17-06: public deployment inputs. Copy to ignored .env.fuji for local use.
# Optional HTTPS endpoint. Keep URLs containing provider credentials outside Git.
FUJI_RPC_URL=
# Distinct, nonzero public test-wallet addresses (0x followed by 40 hex digits).
FUJI_BUYER_ADDRESS=
FUJI_MERCHANT_ADDRESS=
FUJI_RESOLVER_ADDRESS=
# Optional for local simulation. Required for meaningful live-fork preflight.
FUJI_DEPLOYER_ADDRESS=
# Explicit decimal integer in base units (18 decimals); minimum 1903 for the fixture.
FUJI_MOCK_INITIAL_SUPPLY=
